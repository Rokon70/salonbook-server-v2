PORT=5001
# MongoDB (same database that the client's Better Auth uses)
MONGODB_URI=
MONGODB_DB=salonbook
# URL(s) of the Next.js client(s) — comma separated. v2 preview uses port 3001.
CLIENT_URL=http://localhost:3001,https://salonbook-client-gamma-three.vercel.app
# Must equal BETTER_AUTH_URL of the client (JWT issuer + JWKS source)
AUTH_URL=https://salonbook-client-gamma-three.vercel.app
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd
IMGBB_API_KEY=
